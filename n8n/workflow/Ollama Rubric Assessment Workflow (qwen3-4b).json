      "id": "cb95303c-3dd2-4da7-b0b6-4638022d17b6",
      "name": "Get Prompt Template"
    },
    {
      "parameters": {
        "jsCode": "// จับเวลาเริ่มก่อนเรียกโมเดล (ms, epoch)\nconst items = $input.all();\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    startTime: Date.now()\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        512
      ],
      "id": "897e9120-c837-4d31-9626-1e8c5979f2f2",
      "name": "Start Timer"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"qwen3:4b\", messages: [ { role: \"user\", content: $('Get Prompt Template').item.json.prompt.replace('%%ESSAY_JSON%%', JSON.stringify($('Loop Each File').item.json.content)) } ], think:false, options: { temperature: 0, num_ctx: 32768 }, stream: false }) }}",
        "options": {
          "timeout": 900000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2592,
        512
      ],
      "id": "7bfdb3de-19f4-4661-a5e3-f1211b010815",
      "name": "Call Ollama API",
      "notesInFlow": true,
      "notes": "ใช้ gemma3:4b (official จาก Google ไม่ใช่ fine-tune ภาษาไทย) — sanity test + JSON schema mimic test ผ่านดีทั้งคู่ (self-identify ถูก, JSON ตรง schema, evidence ไม่หลอน) ไม่มี thinking leak เหมือนตระกูล Qwen3 เป็นตัวแทน 'non-Thai-finetune, non-Qwen family' ตัวแรกที่ทดสอบเต็มรูปแบบ หลัง Typhoon2.5/Chinda (Thai fine-tune) แสดง leniency bias ทั้งคู่"
    },
    {
      "parameters": {
        "jsCode": "// แกะข้อความคำตอบ + token usage จาก response ของ Ollama /api/chat\n// พร้อมคำนวณเวลาที่ใช้ (ms) เทียบกับ Start Timer\nconst resp = $input.item.json;\nconst startTime = $('Start Timer').item.json.startTime;\nconst elapsed_ms = Date.now() - startTime;\n\nconst content = resp?.message?.content || '';\n\nreturn [{\n  json: {\n    text: content,\n    elapsed_ms,\n    prompt_tokens: resp.prompt_eval_count ?? null,\n    completion_tokens: resp.eval_count ?? null,\n    total_tokens: (resp.prompt_eval_count ?? 0) + (resp.eval_count ?? 0)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        512
      ],
      "id": "e08135df-3851-41a1-9ceb-47137a7652bf",
      "name": "Extract Response + Tokens"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://my-python-api:5000/assess-expand-tokens",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "file_name",
              "value": "={{ $('Loop Each File').item.json.fileName }}"
            },
            {
              "name": "raw_response",
              "value": "={{ $json.text }}"
            },
            {
              "name": "elapsed_ms",
              "value": "={{ $json.elapsed_ms }}"
            },
            {
              "name": "prompt_tokens",
              "value": "={{ $json.prompt_tokens }}"
            },
            {
              "name": "completion_tokens",
              "value": "={{ $json.completion_tokens }}"
            },
            {
              "name": "total_tokens",
              "value": "={{ $json.total_tokens }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
