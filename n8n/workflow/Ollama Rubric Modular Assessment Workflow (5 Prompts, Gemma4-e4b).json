        "jsCode": "const p_txt = $('Call Ollama P').item.json.message.content;\nlet issues = \"[]\";\ntry {\n  issues = JSON.stringify(JSON.parse(p_txt.replace(/```json|```/g, \"\").trim()).issues_from_problem || []);\n} catch (e) {}\n\nconst prompt_s = $('Get Prompt S').item.json.prompt\n  .replace('%%ISSUES_FROM_PROBLEM%%', issues)\n  .replace('%%ESSAY_JSON%%', JSON.stringify($('Loop Each File').item.json.content));\n\nconst body = {\n  model: \"gemma4:latest\",\n  messages: [ { role: \"user\", content: prompt_s } ],\n  think: false,\n  format: \"json\",\n  options: { temperature: 0, num_ctx: 32768, top_p: 0.8, top_k: 20 },\n  stream: false\n};\n\nreturn [{ json: { body } }];"
