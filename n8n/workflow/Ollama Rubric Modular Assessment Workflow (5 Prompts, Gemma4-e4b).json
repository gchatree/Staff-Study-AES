      "name": "Call Ollama S"
    },
    {
      "parameters": {
        "jsCode": "function cleanJson(txt) {\n  if (!txt) return {};\n  const cleaned = txt.replace(/```json|```/g, \"\").trim();\n  const start = cleaned.indexOf(\"{\");\n  const end = cleaned.lastIndexOf(\"}\");\n  if (start !== -1 && end !== -1) {\n    try { return JSON.parse(cleaned.substring(start, end + 1)); } catch(e) {}\n  }\n  return {};\n}\n\nconst p_resp = $('Call Ollama P').item.json;\nconst f_resp = $('Call Ollama F').item.json;\nconst c_resp = $('Call Ollama C').item.json;\nconst r_resp = $('Call Ollama R').item.json;\nconst s_resp = $('Call Ollama S').item.json;\n\nconst p_obj = cleanJson(p_resp?.message?.content);\nconst f_obj = cleanJson(f_resp?.message?.content);\nconst c_obj = cleanJson(c_resp?.message?.content);\nconst r_obj = cleanJson(r_resp?.message?.content);\nconst s_obj = cleanJson(s_resp?.message?.content);\n\nconst merged = {\n  issues_from_problem: p_obj.issues_from_problem || [],\n  results: {\n    ...(p_obj.results || {}),\n    ...(f_obj.results || {}),\n    ...(c_obj.results || {}),\n    ...(r_obj.results || {}),\n    ...(s_obj.results || {})\n  },\n  S_level: (s_obj.S_level !== undefined ? s_obj.S_level : 0)\n};\n\nconst total_prompt_tokens = (p_resp.prompt_eval_count || 0) + (f_resp.prompt_eval_count || 0) + (c_resp.prompt_eval_count || 0) + (r_resp.prompt_eval_count || 0) + (s_resp.prompt_eval_count || 0);\nconst total_completion_tokens = (p_resp.eval_count || 0) + (f_resp.eval_count || 0) + (c_resp.eval_count || 0) + (r_resp.eval_count || 0) + (s_resp.eval_count || 0);\n\nreturn [{\n  json: {\n    text: JSON.stringify(merged),\n    prompt_tokens: total_prompt_tokens,\n    completion_tokens: total_completion_tokens,\n    total_tokens: total_prompt_tokens + total_completion_tokens\n  }\n}];\n"
      },
