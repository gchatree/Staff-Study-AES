    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: $('Get Prompt Template').item.json.prompt.replace('%%ESSAY_JSON%%', JSON.stringify($('Loop Each File').item.json.content)) } ] } ], generationConfig: { temperature: 0 } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1296,
        -96
      ],
      "id": "19a4167c-23b4-45cf-bd49-6e202bb9f7f1",
      "name": "Call Gemini API Direct",
      "notesInFlow": true,
      "credentials": {
        "googlePalmApi": {
          "id": "1vsYBAd83RMLEk91",
          "name": "Google Gemini(PaLM) Api account 2"
        },
        "httpQueryAuth": {
          "id": "bxCLrUIrlq9mOUMe",
          "name": "Query Auth account"
        }
      },
      "notes": "เรียก generateContent ตรง (ไม่ผ่าน chainLlm) เพื่อให้ได้ usageMetadata (token จริง) ติดมาในคำตอบ — credential ใช้ตัวเดียวกับที่ node 'Google Gemini Chat Model' ในสองไฟล์เดิมใช้อยู่ ถ้า dropdown ใน n8n ไม่เจอ authentication type นี้ ให้เปลี่ยนเป็น Generic Credential Type -> Query Auth แล้วใส่ API key เป็น query param ชื่อ key แทน"
    },
    {
      "parameters": {
        "jsCode": "// แกะข้อความคำตอบ + token usage จาก response ของ Gemini generateContent ตรง\n// พร้อมคำนวณเวลาที่ใช้ (ms) เทียบกับ Start Timer\nconst resp = $input.item.json;\nconst startTime = $('Start Timer').item.json.startTime;\nconst elapsed_ms = Date.now() - startTime;\n\nconst text = resp?.candidates?.[0]?.content?.parts?.[0]?.text || '';\nconst usage = resp?.usageMetadata || {};\n\nreturn [{\n  json: {\n    text,\n    elapsed_ms,\n    prompt_tokens: usage.promptTokenCount ?? null,\n    completion_tokens: usage.candidatesTokenCount ?? null,\n    total_tokens: usage.totalTokenCount ?? null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        -96
      ],
      "id": "c85db59e-9db0-4adf-80ef-4157deedb097",
      "name": "Extract Response + Tokens"
    },
